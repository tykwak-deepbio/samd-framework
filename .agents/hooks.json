{
  "samd-pre-write-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_pre_write_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
